    "$type": { "const": "ai.bridgework.authorityCheckout.breakContext" },
    "schemaVersion": { "const": "0.1" },
    "challenge": {
      "type": "object",
      "required": ["id", "title", "invariant", "successCriterion", "requiredProof"]
    },
    "materials": { "type": "object" },
    "apertureRules": { "type": "array", "items": { "type": "string" } },
    "expectedOutput": { "type": "object" }
  },
  "additionalProperties": true
}
